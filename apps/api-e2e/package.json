{
  "name": "@express-api-template/api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "projectType": "application",
    "implicitDependencies": [
      "@express-api-template/api"
    ],
    "targets": {
      "e2e": {
        "outputs": [
          "{workspaceRoot}/coverage/{e2eProjectRoot}",
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@express-api-template/api:build",
          "@express-api-template/api:serve"
        ],
        "options": {
          "passWithNoTests": true
        }
      }
    },
    "// targets": "to see all targets run: nx show project @express-api-template/api-e2e --web"
  }
}
